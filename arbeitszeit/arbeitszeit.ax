# @name      Arbeitszeit
# @desc      Geleistete Arbeitszeit inkl. Pausenabzug; Icon wechselt bei Ueberstunden
# @author    kirkanos
# @version   1.5
# @config    start      text   "Arbeitsbeginn"           default="" help="Format: SS:MM"
# @config    soll       number "Sollstunden"             default=8 min=1 max=12 unit=h
# @config    pause      number "Gedrueckte Pause"        default=0 min=0 max=480 unit=min help="Summe der heute gedrueckten Pausen; wird gegen die gesetzliche gerechnet"
# @config    farbe      color  "Farbe"                   default=#00CC44
# @config    ueberzeit  color  "Farbe Ueberstunden"      default=#FF8800
# @config    icon_unter text   "Icon (unter Sollzeit)"   default="5582"
# @config    icon_ueber text   "Icon (Ueberstunden)"     default="24443"
# @config    ueber_max  number "Ueberstunden-Skala"      default=2 min=1 max=6 unit=h help="Wie viele Ueberstunden der Balken zusaetzlich fasst"
# @config    max        number "Maximale Arbeitszeit"    default=10 min=1 max=14 unit=h help="Ab hier ertoent die Fanfare"
# @config    mqtt       bool   "MQTT (Stream Deck)"      default=true help="Zustand auf <Topic>/state, Befehle auf <Topic>/cmd"
# @config    topic      text   "MQTT-Topic"              default="awtrix/arbeitszeit"

import string

class Arbeitszeit
  var start_min, soll_min, total_min, max_min, configured
  var farbe, ueberzeit, icon_unter, icon_ueber, track
  var netto, over_min, fanfare_done, last_reset_day, stopped, paused_at, pause_min
  var h_str, mm_str, font_bits
  var mqtt_on, topic, last_pub

  def init()
    self.farbe = store.get("farbe")
    self.ueberzeit = store.get("ueberzeit")
    self.icon_unter = store.get("icon_unter")
    self.icon_ueber = store.get("icon_ueber")
    self.soll_min = store.get("soll") * 60
    self.total_min = self.soll_min + store.get("ueber_max") * 60
    self.max_min = store.get("max") * 60
    # unlit Balken-Track = Farbe bei einem Viertel Helligkeit, Kanal fuer Kanal
    self.track = rgb(((self.farbe >> 16) & 0xFF) / 4, ((self.farbe >> 8) & 0xFF) / 4, (self.farbe & 0xFF) / 4)
    self.configured = false
    self.netto = nil
    self.over_min = 0
    self.fanfare_done = false
    self.last_reset_day = -1
    self.stopped = false
    self.paused_at = nil
    self.pause_min = store.get("pause")           # als Einstellung abgelegt, damit auch das Stream Deck ohne MQTT drankommt
    self.h_str = nil
    self.mm_str = nil
    # 3x5-Pixelschrift, je Zeile 3 Bit von oben - dieselbe Tabelle, mit der auch
    # die mitgelieferten Apps der TC002 ihre grossen Ziffern zeichnen.
    self.font_bits = {"0": 31599, "1": 11415, "2": 29671, "3": 29647, "4": 23497,
                      "5": 31183, "6": 31215, "7": 29330, "8": 31727, "9": 31695}
    # MQTT optional: ohne Broker wirkungslos, mit Schalter aus wird nichts gesendet
    self.mqtt_on = store.get("mqtt")
    self.topic = store.get("topic")
    self.last_pub = -1

    var m = re.search("(\\d+):(\\d+)", store.get("start"))
    if m == nil return end
    self.start_min = self.parse_int(m[1]) * 60 + self.parse_int(m[2])
    self.configured = true
  end

  def setup()
    if self.mqtt_on
      mqtt.subscribe(self.topic + "/cmd", / t, p -> self.apply(p))
    end
  end

  # num() liest "09" als Oktalzahl und scheitert - deshalb Ziffern selbst umwandeln
  def parse_int(s)
    var n = 0
    for i : 0 .. size(s) - 1
      n = n * 10 + string.find("0123456789", s[i])
    end
    return n
  end

  def loop()
    if hour() < 0
      return
    end
    if self.configured && hour() == 0 && minute() == 0 && self.last_reset_day != day()
      self.last_reset_day = day()
      self.apply("reset")
      return
    end
    if !self.configured
      # Ab 8 Uhr als Erinnerung mit 0:00 zeigen, bis ein Arbeitsbeginn gesetzt wird
      self.netto = 0
      self.over_min = 0
      self.h_str = "0"
      self.mm_str = "00"
    elif !self.stopped                # pausiert: eingefroren lassen
      # Anwesenheit seit dem Einstempeln, gedrueckte Pausen noch enthalten
      var anwesend = hour() * 60 + minute() - self.start_min
      if anwesend < 0
        anwesend = 0
      end
      # Gedrueckte Pausen zaehlen auf die gesetzliche an, statt zusaetzlich zu
      # kosten: abgezogen wird die kleinste Dauer, die sowohl die gedrueckte Pause
      # abdeckt als auch die Pflicht fuer die dabei herauskommende Arbeitszeit.
      # Liegt die Anwesenheit nur knapp ueber einer Schwelle, reicht dafuer weniger
      # als die volle Pause - die Arbeitszeit wird dann auf die Schwelle gedeckelt.
      var abzug = self.pause_min
      if anwesend - abzug > 6 * 60 && abzug < 30
        abzug = min(30, anwesend - 6 * 60)
        if abzug < self.pause_min
          abzug = self.pause_min
        end
      end
      if anwesend - abzug > 9 * 60 && abzug < 45
        abzug = min(45, anwesend - 9 * 60)
        if abzug < self.pause_min
          abzug = self.pause_min
        end
      end
      self.netto = anwesend - abzug
      if self.netto < 0
        self.netto = 0
      end
      self.over_min = self.netto - self.soll_min
      if self.over_min < 0
        self.over_min = 0
      end
      if self.netto >= self.max_min && !self.fanfare_done
        self.fanfare_done = true
        notify({"text": "Feierabend!", "sound": {"rtttl": "fanfare:d=8,o=5,b=140:c,e,g,c6,g,c6,2e6"}})
      end
      var mn = self.netto % 60
      self.h_str = str(self.netto / 60)
      self.mm_str = mn < 10 ? "0" + str(mn) : str(mn)
    end
    # Einmal pro Minute melden, damit ein neu verbundener Client den Zustand bekommt
    if self.mqtt_on && hour() * 60 + minute() != self.last_pub
      self.publish_state()
    end
  end

  def on_button(btn)
    if btn == "select"
      self.apply(!self.configured ? "clock_in" : (!self.stopped ? "pause" : "resume"))
    end
  end

  # Ein Befehl vom Select-Knopf, per MQTT oder von Mitternacht: clock_in, pause, resume, reset, state.
  # Unpassende Befehle (z. B. pause ohne laufende Zeit) werden ignoriert.
  def apply(cmd)
    var now = hour() * 60 + minute()
    if cmd == "clock_in" && !self.configured
      self.start_min = now
      self.configured = true
      self.stopped = false
      self.paused_at = nil
      self.pause_min = 0
      self.fanfare_done = false
    elif cmd == "pause" && self.configured && !self.stopped
      self.stopped = true
      self.paused_at = now                          # ausstempeln: Zeit einfrieren
    elif cmd == "resume" && self.configured && self.stopped
      var pause_len = now - self.paused_at
      if pause_len < 0
        pause_len = 0
      end
      self.pause_min += pause_len                   # aufaddieren; der Arbeitsbeginn bleibt stehen
      self.stopped = false
      self.paused_at = nil
    elif cmd == "reset" && self.configured
      self.configured = false
      self.netto = nil
      self.h_str = nil
      self.mm_str = nil
      self.fanfare_done = false
      self.stopped = false
      self.paused_at = nil
      self.pause_min = 0
    elif cmd != "state"
      return
    end
    if cmd == "clock_in"
      # start_min als "SS:MM" zurueck in die Einstellungen schreiben
      var hh = self.start_min / 60
      var mi = self.start_min % 60
      store.set("start", (hh < 10 ? "0" + str(hh) : str(hh)) + ":" + (mi < 10 ? "0" + str(mi) : str(mi)))
      store.set("pause", 0)
    elif cmd == "resume"
      store.set("pause", self.pause_min)
    elif cmd == "reset"
      store.set("start", "")
      store.set("pause", 0)
    end
    self.publish_state()
  end

  # Zustand als JSON auf <topic>/state; der String ist klein und fest, kein json noetig
  def publish_state()
    if !self.mqtt_on return end
    var s = self.configured ? str(self.start_min) : "null"
    var p = (self.configured && self.stopped) ? "true" : "false"
    var pa = (self.configured && self.stopped && self.paused_at != nil) ? str(self.paused_at) : "0"
    var pm = self.configured ? str(self.pause_min) : "0"
    var n = self.netto != nil ? str(self.netto) : "0"
    mqtt.publish(self.topic + "/state",
      "{\"start_min\":" + s + ",\"paused\":" + p + ",\"paused_at\":" + pa +
      ",\"pause_min\":" + pm + ",\"net_min\":" + n + "}")
    self.last_pub = hour() * 60 + minute()
  end

  def should_show()
    if self.configured
      return self.netto != nil
    end
    return hour() >= 8               # Erinnerung ab 8 Uhr, auch ohne gesetzten Arbeitsbeginn
  end

  def draw()
    clear()
    if self.netto == nil
      return
    end
    var col = self.over_min > 0 ? self.ueberzeit : self.farbe
    var ic = self.over_min > 0 ? self.icon_ueber : self.icon_unter
    # Die beiden Panels bekommen eigene Layouts statt einer skalierten Fassung:
    # 32x8 ist auf jeden Pixel angewiesen, 52x16 hat Platz fuer grosse Ziffern.
    if height() >= 16
      self.draw_gross(col, ic)
    else
      self.draw_klein(col, ic)
    end
  end

  # TC001, 32x8: Icon links, Zeit in der kleinen Schrift, einzeiliger Balken.
  def draw_klein(col, ic)
    if !icon(ic, 0, 0)
      rect_fill(0, 0, 8, 8, 0x222222)
    end
    var w = width() - 9
    if self.h_str != nil
      var wh = text_width(self.h_str)
      var wc = text_width(":")
      var x = 9 + (w - (wh + wc + text_width(self.mm_str))) / 2
      text(x, 6, self.h_str, col)
      if self.blinkt()
        text(x + wh, 6, ":", col)
      end
      text(x + wh + wc, 6, self.mm_str, col)
    end
    self.balken(9, 7, w, 1)
  end

  # TC002, 52x16: 16x16-Icon links, Textspalte ab x=17 - so teilen sich die
  # mitgelieferten Apps dieses Panel auf. Die Zeit wird in der 3x5-Pixelschrift
  # gesetzt und pixelweise verdoppelt; die "large"-Schrift waere nur 7 Zeilen hoch.
  def draw_gross(col, ic)
    var h = height()
    var ix = 17
    if !icon(ic, 0, 0)
      rect_fill(0, 0, 16, 16, 0x222222)
    end
    var avail = width() - ix
    var bar_h = 3
    if self.h_str != nil
      var sc = 2
      var dw = 3 * sc + 1                       # Vorschub je Ziffer
      var cw = sc + 2                           # Vorschub Doppelpunkt
      var nd = size(self.h_str) + size(self.mm_str)
      var x = ix + (avail - (nd * dw + cw - 1)) / 2
      var y = (h - bar_h - 1 - 5 * sc) / 2
      x = self.pixtext(self.h_str, x, y, sc, col)
      if self.blinkt()
        rect_fill(x, y + sc, sc, sc, col)
        rect_fill(x, y + 3 * sc, sc, sc, col)
      end
      self.pixtext(self.mm_str, x + cw, y, sc, col)
    end
    self.balken(ix, h - bar_h, avail, bar_h)
  end

  # Pixelschrift vergroessert zeichnen; liefert die x-Position dahinter
  def pixtext(s, x, y, sc, col)
    for i : 0 .. size(s) - 1
      var mask = self.font_bits.find(s[i], 0)
      for row : 0 .. 4
        var bits = (mask >> ((4 - row) * 3)) & 7
        for c : 0 .. 2
          if bits & (1 << (2 - c))
            rect_fill(x + c * sc, y + row * sc, sc, sc, col)
          end
        end
      end
      x += 3 * sc + 1
    end
    return x
  end

  # Doppelpunkt blinkt nur, solange die Zeit laeuft
  def blinkt()
    return !(self.configured && !self.stopped) || (now_ms() / 500) % 2 == 0
  end

  # Balken: normale Zeit in Farbe, ab Sollzeit Ueberstunden in der anderen
  def balken(x, y, w, bh)
    rect_fill(x, y, w, bh, self.track)
    var bis_soll = self.netto < self.soll_min ? self.netto : self.soll_min
    var normal_fill = w * bis_soll / self.total_min
    if normal_fill > 0
      rect_fill(x, y, normal_fill, bh, self.farbe)
    end
    if self.over_min > 0
      var ueber_fill = w * clamp(self.over_min, 0, self.total_min - self.soll_min) / self.total_min
      if ueber_fill > 0
        rect_fill(x + normal_fill, y, ueber_fill, bh, self.ueberzeit)
      end
    end
  end
end

return Arbeitszeit()
