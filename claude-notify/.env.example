# Copy this file to .env next to the installed hook script
# (~/.claude/hooks/.env) and fill in your device details.
# awtrix-notify.sh sources it automatically.

# IP address or mDNS hostname of the AWTRIX NG panel.
AWTRIX_NOTIFY_HOST=192.168.1.42
#AWTRIX_NOTIFY_HOST=awtrixng-ab34cd.local

# Optional: port of the "AWTRIX Remote" Stream Deck plugin's Claude Status
# listener (127.0.0.1). Leave unset without a Stream Deck; nothing is sent then.
#AWTRIX_DECK_PORT=42931
