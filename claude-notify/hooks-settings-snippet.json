{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/awtrix-notify.sh done",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/awtrix-notify.sh input",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
