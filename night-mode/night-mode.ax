# @name    Night Mode
# @desc    Mutes sound and dims the panel during nightly quiet hours
# @author  awtrix-ng-scripts
# @version 1.1
# @headless true
# @config  start           text   "Night start (HH:MM)" default="22:00"
# @config  end             text   "Night end (HH:MM)"   default="07:00"
# @config  nightBrightness slider "Night brightness"     default=0 min=0 max=255
# @config  nightVolume     slider "Night volume"         default=0 min=0 max=100

class NightMode
  var startH, startM, endH, endM, nightBrightness, nightVolume
  var active
  var prevBrightness, prevVolume, prevAutoBrightness

  def parse_time(s, dh, dm)
    var m = re.search("([0-9]+):([0-9]+)", s)
    if m == nil return [dh, dm] end
    var h = num(m[1])
    var mn = num(m[2])
    if h == nil || mn == nil return [dh, dm] end
    return [h, mn]
  end

  def init()
    var st = self.parse_time(store.get("start"), 22, 0)
    self.startH = st[0]
    self.startM = st[1]
    var et = self.parse_time(store.get("end"), 7, 0)
    self.endH = et[0]
    self.endM = et[1]
    self.nightBrightness = store.get("nightBrightness")
    self.nightVolume = store.get("nightVolume")
    self.active = store.get("active", false)
    self.prevBrightness = store.get("prevBrightness")
    self.prevVolume = store.get("prevVolume")
    self.prevAutoBrightness = store.get("prevAutoBrightness")
  end

  def in_night(h, m)
    var now = h * 60 + m
    var from = self.startH * 60 + self.startM
    var upto = self.endH * 60 + self.endM
    if from == upto return false end
    if from < upto
      return now >= from && now < upto
    end
    return now >= from || now < upto
  end

  def loop()
    if hour() < 0 return end
    var night = self.in_night(hour(), minute())
    if night && !self.active
      self.prevBrightness = settings.get("brightness")
      self.prevVolume = settings.get("volume")
      self.prevAutoBrightness = settings.get("autoBrightness")
      store.set("prevBrightness", self.prevBrightness)
      store.set("prevVolume", self.prevVolume)
      store.set("prevAutoBrightness", self.prevAutoBrightness)
      settings.set("autoBrightness", false)
      settings.set("brightness", self.nightBrightness)
      # Lautstaerke heisst "volume" (0-100). Das frueher benutzte "soundEnabled"
      # kennt die Firmware seit 1.2 nicht mehr: settings.set() liefert dafuer
      # false und aendert nichts - die Stummschaltung lief also ins Leere.
      settings.set("volume", self.nightVolume)
      self.active = true
      store.set("active", true)
      log("Night Mode: quiet hours started")
    elif !night && self.active
      settings.set("volume", self.prevVolume == nil ? 60 : self.prevVolume)
      settings.set("brightness", self.prevBrightness == nil ? 120 : self.prevBrightness)
      settings.set("autoBrightness", self.prevAutoBrightness == nil ? false : self.prevAutoBrightness)
      self.active = false
      store.set("active", false)
      log("Night Mode: quiet hours ended")
    end
  end
end

return NightMode()
