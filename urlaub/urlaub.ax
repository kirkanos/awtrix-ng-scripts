# @name     Urlaubscountdown
# @desc     Tage bis Urlaubsbeginn, danach verbleibende Urlaubstage
# @author   kirkanos
# @version  1.3
# @config   start    text  "Urlaubsbeginn"     default="" help="Format: JJJJ-MM-TT"
# @config   ende     text  "Urlaubsende"       default="" help="Format: JJJJ-MM-TT"
# @config   vor      color "Farbe davor"       default=#3399FF
# @config   waehrend color "Farbe im Urlaub"   default=#00CC44
# @config   icon_ur  text  "Icon (im Urlaub)"  default="15644"
# @config   icon_vor text  "Icon (davor)"      default="" help="LaMetric-Icon-ID, leer = gezeichneter Laptop"

import string

class Urlaub
  var start_days, end_days, configured
  var vor, waehrend, icon_ur, icon_vor
  var today_days, label, tint, in_urlaub, font_bits

  def init()
    self.vor = store.get("vor")
    self.waehrend = store.get("waehrend")
    self.icon_ur = store.get("icon_ur")
    self.icon_vor = store.get("icon_vor")
    self.tint = self.vor
    self.configured = false
    self.today_days = nil
    self.label = nil
    self.in_urlaub = false
    # 3x5-Pixelschrift, je Zeile 3 Bit von oben - dieselbe Tabelle, mit der auch
    # die mitgelieferten Apps der TC002 ihre grossen Ziffern zeichnen; "T" ergaenzt.
    self.font_bits = {"0": 31599, "1": 11415, "2": 29671, "3": 29647, "4": 23497,
                      "5": 31183, "6": 31215, "7": 29330, "8": 31727, "9": 31695,
                      "T": 29842}

    var s = re.search("(\\d+)-(\\d+)-(\\d+)", store.get("start"))
    var e = re.search("(\\d+)-(\\d+)-(\\d+)", store.get("ende"))
    if s == nil return end
    if e == nil return end
    self.start_days = self.civil_days(self.parse_int(s[1]), self.parse_int(s[2]), self.parse_int(s[3]))
    self.end_days = self.civil_days(self.parse_int(e[1]), self.parse_int(e[2]), self.parse_int(e[3]))
    self.configured = true
  end

  # num() liest "09" als Oktalzahl und scheitert - deshalb Ziffern selbst umwandeln
  def parse_int(s)
    var n = 0
    for i : 0 .. size(s) - 1
      n = n * 10 + string.find("0123456789", s[i])
    end
    return n
  end

  # Tage seit 1970-01-01 aus Jahr/Monat/Tag (civil_from_days-Algorithmus)
  def civil_days(y, m, d)
    if m <= 2 y -= 1 end
    var era = y / 400
    var yoe = y - era * 400
    var mm = m > 2 ? m - 3 : m + 9
    var doy = (153 * mm + 2) / 5 + d - 1
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
  end

  def loop()
    if !self.configured
      return
    end
    if hour() < 0
      return
    end
    self.today_days = self.civil_days(year(), month(), day())
    if self.today_days < self.start_days
      self.label = str(self.start_days - self.today_days) + "T"
      self.tint = self.vor
      self.in_urlaub = false
    elif self.today_days <= self.end_days
      self.label = str(self.end_days - self.today_days) + "T"
      self.tint = self.waehrend
      self.in_urlaub = true
    end
  end

  def should_show()
    if !self.configured
      return false
    end
    if self.today_days == nil
      return false
    end
    return self.today_days <= self.end_days
  end

  # Die beiden Panels bekommen eigene Layouts statt einer skalierten Fassung:
  # 32x8 ist auf jeden Pixel angewiesen, 52x16 hat Platz fuer grosse Ziffern.
  def draw()
    clear()
    # Auf der TC002 sind die Icons 16x16 und sitzen oben links, auf der TC001
    # 8x8 und vertikal zentriert.
    var gross = height() >= 16
    var is = gross ? 16 : 8
    var iy = gross ? 0 : (height() - 8) / 2
    var ic = self.in_urlaub ? self.icon_ur : self.icon_vor
    if !icon(ic, 0, iy)
      if self.in_urlaub
        rect_fill(0, iy, is, is, 0x222222)
      else
        self.draw_laptop(iy, gross ? 2 : 1)
      end
    end
    if self.label == nil return end
    if height() >= 16
      self.draw_gross()
    else
      var avail = width() - 9
      text(9 + (avail - text_ink_width(self.label)) / 2, 6, self.label, self.tint)
    end
  end

  # TC002, 52x16: 16x16-Icon links, Textspalte ab x=17 - so teilen sich die
  # mitgelieferten Apps dieses Panel auf. Die Tagezahl steht in der
  # 3x5-Pixelschrift, pixelweise verdoppelt.
  def draw_gross()
    var ix = 17
    var sc = 2
    var avail = width() - ix
    var n = size(self.label)
    var x = ix + (avail - (n * (3 * sc + 1) - 1)) / 2
    self.pixtext(self.label, x, (height() - 5 * sc) / 2, sc, self.tint)
  end

  # Pixelschrift vergroessert zeichnen
  def pixtext(s, x, y, sc, col)
    for i : 0 .. size(s) - 1
      var mask = self.font_bits.find(s[i], 0)
      for row : 0 .. 4
        var bits = (mask >> ((4 - row) * 3)) & 7
        for c : 0 .. 2
          if bits & (1 << (2 - c))
            rect_fill(x + c * sc, y + row * sc, sc, sc, col)
          end
        end
      end
      x += 3 * sc + 1
    end
  end

  # Arbeitender Laptop mit blinkendem Terminaltext
  def draw_laptop(y, s)
    rect_fill(0, y + 6 * s, 8 * s, 2 * s, 0x555555)       # Tastatur/Basis
    rect_fill(s, y, 6 * s, 6 * s, 0x333333)               # Bildschirmrahmen
    rect_fill(2 * s, y + s, 4 * s, 4 * s, 0x001830)       # Bildschirm
    rect_fill(3 * s, y + 4 * s, s, s, 0x00FF66)
    if (now_ms() / 500) % 2 == 0
      rect_fill(3 * s, y + 2 * s, 2 * s, s, 0x00FF66)
      rect_fill(3 * s, y + 3 * s, s, s, 0x00FF66)
    end
  end
end

return Urlaub()
