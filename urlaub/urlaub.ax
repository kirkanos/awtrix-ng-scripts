# @name     Urlaubscountdown
# @desc     Tage bis Urlaubsbeginn, danach verbleibende Urlaubstage
# @author   kirkanos
# @version  1.0
# @config   start    text  "Urlaubsbeginn"     default="" help="Format: JJJJ-MM-TT"
# @config   ende     text  "Urlaubsende"       default="" help="Format: JJJJ-MM-TT"
# @config   vor      color "Farbe davor"       default=#3399FF
# @config   waehrend color "Farbe im Urlaub"   default=#00CC44
# @config   icon_ur  text  "Icon (im Urlaub)"  default="15644"
# @config   icon_vor text  "Icon (davor)"      default="" help="LaMetric-Icon-ID, leer = gezeichneter Laptop"

import string

class Urlaub
  var start_days, end_days, configured
  var vor, waehrend, icon_ur, icon_vor
  var today_days, label, tint, in_urlaub

  def init()
    self.vor = store.get("vor")
    self.waehrend = store.get("waehrend")
    self.icon_ur = store.get("icon_ur")
    self.icon_vor = store.get("icon_vor")
    self.tint = self.vor
    self.configured = false
    self.today_days = nil
    self.label = nil
    self.in_urlaub = false

    var s = re.search("(\\d+)-(\\d+)-(\\d+)", store.get("start"))
    var e = re.search("(\\d+)-(\\d+)-(\\d+)", store.get("ende"))
    if s == nil return end
    if e == nil return end
    self.start_days = self.civil_days(self.parse_int(s[1]), self.parse_int(s[2]), self.parse_int(s[3]))
    self.end_days = self.civil_days(self.parse_int(e[1]), self.parse_int(e[2]), self.parse_int(e[3]))
    self.configured = true
  end

  # num() liest "09" als Oktalzahl und scheitert - deshalb Ziffern selbst umwandeln
  def parse_int(s)
    var n = 0
    for i : 0 .. size(s) - 1
      n = n * 10 + string.find("0123456789", s[i])
    end
    return n
  end

  # Tage seit 1970-01-01 aus Jahr/Monat/Tag (civil_from_days-Algorithmus)
  def civil_days(y, m, d)
    if m <= 2 y -= 1 end
    var era = y / 400
    var yoe = y - era * 400
    var mm = m > 2 ? m - 3 : m + 9
    var doy = (153 * mm + 2) / 5 + d - 1
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
  end

  def loop()
    if !self.configured
      return
    end
    if hour() < 0
      return
    end
    self.today_days = self.civil_days(year(), month(), day())
    if self.today_days < self.start_days
      self.label = str(self.start_days - self.today_days) + "T"
      self.tint = self.vor
      self.in_urlaub = false
    elif self.today_days <= self.end_days
      self.label = str(self.end_days - self.today_days) + "T"
      self.tint = self.waehrend
      self.in_urlaub = true
    end
  end

  def should_show()
    if !self.configured
      return false
    end
    if self.today_days == nil
      return false
    end
    return self.today_days <= self.end_days
  end

  def draw()
    clear()
    if self.in_urlaub
      if !icon(self.icon_ur, 0, 0)
        rect_fill(0, 0, 8, 8, 0x222222)
      end
    else
      if !icon(self.icon_vor, 0, 0)
        self.draw_laptop()               # kein Icon konfiguriert oder Dekodierung fehlgeschlagen
      end
    end
    if self.label != nil
      var avail = width() - 9
      text(9 + (avail - text_ink_width(self.label)) / 2, 6, self.label, self.tint)
    end
  end

  # Arbeitender Laptop mit blinkendem Terminaltext
  def draw_laptop()
    rect_fill(0, 6, 8, 2, 0x555555)                # Tastatur/Basis
    rect(1, 0, 6, 6, 0x333333)                      # Bildschirmrahmen
    rect_fill(2, 1, 4, 4, 0x001830)                # Bildschirm
    pixel(3, 4, 0x00FF66)
    if (now_ms() / 500) % 2 == 0
      pixel(3, 2, 0x00FF66)
      pixel(4, 2, 0x00FF66)
      pixel(3, 3, 0x00FF66)
    end
  end
end

return Urlaub()
